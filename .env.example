NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

FOCUSNFE_TOKEN_HOMOLOGACAO=
FOCUSNFE_TOKEN_PRODUCAO=
FOCUSNFE_AMBIENTE=homologacao

# Gerado aleatoriamente (ex: openssl rand -hex 32)
# Configurar também no painel da Vercel em Settings > Environment Variables
CRON_SECRET=

# Zoho Mail SMTP — para envio de e-mails transacionais
# Zoho Mail — confira no console: Configurações do Mail → Ferramentas e configurações
# Saída/SMTP: smtp.zoho.com | 465 SSL (ou 587 TLS)
SMTP_USER=suporte@nexcoop.com.br
SMTP_PASS=
SMTP_HOST=smtp.zoho.com
SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_FROM=suporte@nexcoop.com.br
